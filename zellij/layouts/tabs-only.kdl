layout {
    tab {
        pane
        pane size=1 borderless=true {
            plugin location="file:/Users/tkallio/.config/zellij/plugins/zjstatus.wasm" {
                // --- Layout ---
                format_left  "{mode} #[bg=#181825]{tabs}"
                format_right ""
                format_space "#[bg=#181825]"

                // --- Mode indicator (padded to 7 chars) ---
                mode_normal        "#[bg=#89B4FA,fg=#181825,bold]  NORMAL  "
                mode_locked        "#[bg=#6C7086,fg=#181825,bold]  LOCKED  "
                mode_tmux          "#[bg=#fab387,fg=#181825,bold]  TMUX    "
                mode_resize        "#[bg=#a6e3a1,fg=#181825,bold]  RESIZE  "
                mode_scroll        "#[bg=#f9e2af,fg=#181825,bold]  SCROLL  "
                mode_pane          "#[bg=#cba6f7,fg=#181825,bold]  PANE    "
                mode_tab           "#[bg=#f38ba8,fg=#181825,bold]  TAB     "
                mode_move          "#[bg=#94e2d5,fg=#181825,bold]  MOVE    "
                mode_search        "#[bg=#f9e2af,fg=#181825,bold]  SEARCH  "
                mode_session       "#[bg=#eba0ac,fg=#181825,bold]  SESSION "
                mode_enter_search  "#[bg=#f9e2af,fg=#181825,bold]  SEARCH  "
                mode_default_to_mode "tmux"

                // --- Tabs ---
                tab_normal              "#[fg=#6C7086,bg=#181825] {name} {fullscreen_indicator}{sync_indicator}{floating_indicator}"
                tab_active              "#[fg=#89B4FA,bg=#181825,bold,italic] {name} {fullscreen_indicator}{sync_indicator}{floating_indicator}"
                tab_fullscreen_indicator "□ "
                tab_sync_indicator       " "
                tab_floating_indicator   "󰉈 "

                // CPU/MEM command widgets disabled for now.
                // zjstatus command widgets are crashing on Zellij 0.44.1.

            }
        }
    }

    new_tab_template {
        pane
        pane size=1 borderless=true {
            plugin location="file:/Users/tkallio/.config/zellij/plugins/zjstatus.wasm" {
                // --- Layout ---
                format_left  "{mode} #[bg=#181825]{tabs}"
                format_right ""
                format_space "#[bg=#181825]"

                // --- Mode indicator (padded to 7 chars) ---
                mode_normal        "#[bg=#89B4FA,fg=#181825,bold]  NORMAL  "
                mode_locked        "#[bg=#6C7086,fg=#181825,bold]  LOCKED  "
                mode_tmux          "#[bg=#fab387,fg=#181825,bold]  TMUX    "
                mode_resize        "#[bg=#a6e3a1,fg=#181825,bold]  RESIZE  "
                mode_scroll        "#[bg=#f9e2af,fg=#181825,bold]  SCROLL  "
                mode_pane          "#[bg=#cba6f7,fg=#181825,bold]  PANE    "
                mode_tab           "#[bg=#f38ba8,fg=#181825,bold]  TAB     "
                mode_move          "#[bg=#94e2d5,fg=#181825,bold]  MOVE    "
                mode_search        "#[bg=#f9e2af,fg=#181825,bold]  SEARCH  "
                mode_session       "#[bg=#eba0ac,fg=#181825,bold]  SESSION "
                mode_enter_search  "#[bg=#f9e2af,fg=#181825,bold]  SEARCH  "
                mode_default_to_mode "tmux"

                // --- Tabs ---
                tab_normal              "#[fg=#6C7086,bg=#181825] {name} {fullscreen_indicator}{sync_indicator}{floating_indicator}"
                tab_active              "#[fg=#89B4FA,bg=#181825,bold,italic] {name} {fullscreen_indicator}{sync_indicator}{floating_indicator}"
                tab_fullscreen_indicator "□ "
                tab_sync_indicator       " "
                tab_floating_indicator   "󰉈 "

                // CPU/MEM command widgets disabled for now.
                // zjstatus command widgets are crashing on Zellij 0.44.1.

            }
        }
    }
}
